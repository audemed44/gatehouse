    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
